<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stellar Drift: Sector Radar</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #171526;
            color: #e2d9f3;
            font-family: 'Georgia', serif;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            position: relative;
        }

        h1 {
            position: absolute;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            color: #ffd166;
            text-shadow: 0 0 10px rgba(255, 209, 102, 0.4);
            font-size: 1.2rem;
            letter-spacing: 1px;
            font-weight: normal;
            z-index: 20;
            pointer-events: none;
        }

        #game-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at center, #27213b, #100e18);
            overflow: hidden;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        .ui-bottom-container {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 380px;
            max-width: 90vw;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            z-index: 5;
            pointer-events: none;
        }

        .score-row {
            display: flex;
            justify-content: space-between;
            width: 100%;
            padding: 0 10px;
            font-size: 0.9rem;
            font-weight: bold;
            color: #f7ede2;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        .bar-row {
            width: 100%;
            padding: 0 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .meter-container {
            width: 100%;
            height: 8px;
            background: rgba(39, 33, 59, 0.8);
            border: 1px solid #6c5b7b;
            border-radius: 4px;
            overflow: hidden;
        }

        #fuel-bar {
            width: 100%;
            height: 100%;
            background: #06d6a0;
            transition: width 0.1s linear;
        }

        #ability-hud {
            background: rgba(39, 33, 59, 0.9);
            border: 1px solid #c7b198;
            padding: 4px 14px;
            font-size: 0.75rem;
            color: #ffd166;
            border-radius: 8px;
            text-align: center;
            letter-spacing: 0.5px;
            display: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
        }

        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(23, 21, 38, 0.94);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 30px;
            z-index: 30;
        }

        .screen.hidden {
            display: none;
        }

        .screen h2 {
            color: #ffd166;
            margin-bottom: 10px;
            font-size: 1.6rem;
            font-weight: normal;
        }

        .screen p {
            margin-bottom: 20px;
            color: #c7b198;
            line-height: 1.5;
            font-size: 0.9rem;
            max-width: 420px;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 260px;
            max-width: 80%;
        }

        .btn {
            background-color: #382e4e;
            color: #f7ede2;
            border: 1px solid #6c5b7b;
            padding: 10px 16px;
            font-size: 0.95rem;
            font-family: 'Georgia', serif;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn:hover:not(:disabled) {
            background-color: #6c5b7b;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(108, 91, 123, 0.5);
        }

        .btn-warm {
            background-color: #b85b72;
            border-color: #e2738a;
        }
        .btn-warm:hover:not(:disabled) {
            background-color: #e2738a;
        }

        .shop-items {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            max-width: 420px;
            margin-bottom: 20px;
            max-height: 280px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .shop-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid #453a56;
            border-radius: 6px;
            padding: 8px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
        }

        .shop-info h4 {
            color: #ffd166;
            font-size: 0.85rem;
            margin-bottom: 2px;
        }
        .shop-info span {
            font-size: 0.7rem;
            color: #9b8da9;
        }

        #cheat-status {
            font-size: 0.75rem;
            color: #e2738a;
            margin-bottom: 10px;
            min-height: 1em;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

    <h1>✨ Stellar Drift: Sector Radar ✨</h1>
    
    <div id="game-container">
        <div id="menu-screen" class="screen">
            <h2>COZY SECTOR</h2>
            <p>Pilot your zero-g cursor using <strong>W A S D</strong>. Harvest crystals, manage fuel, and press <strong>ESC</strong> to pause!</p>
            <div class="btn-group">
                <button class="btn" id="to-game-btn">LAUNCH DRIFT</button>
                <button class="btn" id="difficulty-toggle-btn">MODE: NORMAL</button>
                <button class="btn btn-warm" id="to-shop-btn">COZY SANCTUARY</button>
                <button class="btn" id="to-tutorial-btn">TUTORIAL</button>
            </div>
        </div>

        <div id="tutorial-screen" class="screen hidden">
            <h2 id="tutorial-title">FLIGHT ACADEMY</h2>
            <p id="tutorial-text">Welcome, pilot. Let's run through your core flight operations before you hit open space.</p>
            <div class="btn-group">
                <button class="btn" id="tutorial-next-btn">NEXT</button>
                <button class="btn btn-warm" id="tutorial-back-btn">RETURN</button>
            </div>
        </div>

        <div id="shop-screen" class="screen hidden">
            <h2>COZY SANCTUARY</h2>
            <p>Trade Stardust for permanent passive & active upgrades.</p>
            
            <div class="shop-items">
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Starlight Blink</h4>
                        <span>Instantly teleport forward / 6s cooldown</span>
                    </div>
                    <button class="btn" onclick="buyAbility('blink', 50)">50 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Supernova Pulse</h4>
                        <span>Destroys nearby hazards / 10s cooldown</span>
                    </div>
                    <button class="btn" onclick="buyAbility('pulse', 75)">75 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Astral Shield</h4>
                        <span>Absorbs 1 hazard hit / 8s recharge</span>
                    </div>
                    <button class="btn" onclick="buyAbility('shield', 100)">100 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Magnet Pulse</h4>
                        <span>Pulls nearby crystals / 3s duration</span>
                    </div>
                    <button class="btn" onclick="buyAbility('magnet', 60)">60 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Phase Cloak</h4>
                        <span>Pass through hazards / 2s duration</span>
                    </div>
                    <button class="btn" onclick="buyAbility('cloak', 80)">80 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Decoy Beacon</h4>
                        <span>Spawns fake decoy / draws hazards</span>
                    </div>
                    <button class="btn" onclick="buyAbility('decoy', 70)">70 SD</button>
                </div>
                <div class="shop-item">
                    <div class="shop-info">
                        <h4>Chrono Rewind</h4>
                        <span>Auto-rewinds before a fatal hit / 30s cooldown</span>
                    </div>
                    <button class="btn" onclick="buyAbility('rewind', 120)">120 SD</button>
                </div>
            </div>

            <div id="cheat-status"></div>
            <button class="btn btn-warm" id="back-to-menu-shop">RETURN</button>
        </div>

        <div id="pause-screen" class="screen hidden">
            <h2>DRIFT PAUSED</h2>
            <p>Take a breather, pilot. Your sector is safely frozen.</p>
            <div class="btn-group">
                <button class="btn" id="resume-btn">RESUME DRIFT</button>
                <button class="btn btn-warm" id="menu-from-pause-btn">MAIN MENU</button>
            </div>
        </div>

        <div id="gameover-screen" class="screen hidden">
            <h2>DRIFT CONCLUDED</h2>
            <p id="final-score-text">You gathered 0 Stardust.</p>
            <div class="btn-group">
                <button class="btn" id="restart-btn">REDRIFT</button>
                <button class="btn btn-warm" id="menu-from-gameover-btn">MAIN MENU</button>
            </div>
        </div>

        <canvas id="gameCanvas"></canvas>
    </div>

    <div class="ui-bottom-container">
        <div class="score-row">
            <span id="score-display">STARDUST: 0</span>
            <span id="high-score-display">HIGH: 0</span>
        </div>
        <div class="bar-row">
            <div class="meter-container">
                <div id="fuel-bar"></div>
            </div>
        </div>
        <div id="ability-hud">BLESSING READY</div>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        const scoreDisplay = document.getElementById("score-display");
        const highScoreDisplay = document.getElementById("high-score-display");
        const fuelBar = document.getElementById("fuel-bar");
        const abilityHud = document.getElementById("ability-hud");
        const cheatStatus = document.getElementById("cheat-status");
        
        const menuScreen = document.getElementById("menu-screen");
        const shopScreen = document.getElementById("shop-screen");
        const tutorialScreen = document.getElementById("tutorial-screen");
        const pauseScreen = document.getElementById("pause-screen");
        const gameoverScreen = document.getElementById("gameover-screen");
        const finalScoreText = document.getElementById("final-score-text");

        const tutorialTitle = document.getElementById("tutorial-title");
        const tutorialText = document.getElementById("tutorial-text");
        const tutorialNextBtn = document.getElementById("tutorial-next-btn");
        const difficultyToggleBtn = document.getElementById("difficulty-toggle-btn");

        let score = 0;
        let totalCredits = 0; 
        let highScore = 0;
        let gameRunning = false;
        let gamePaused = false;
        let animationFrameId;
        let isCheatedRun = false;
        let cheatedAbilityMode = null;

        let fuel = 100;
        let maxFuel = 100;

        let activeEffectTimer = 0;
        let decoyEntity = null;
        let positionHistory = [];

        const konamiSequence = [
            "ArrowUp", "ArrowUp", 
            "ArrowDown", "ArrowDown", 
            "ArrowLeft", "ArrowRight", 
            "ArrowLeft", "ArrowRight", 
            "KeyB", "KeyA", "Enter"
        ];
        let konamiInputIndex = 0;

        function loadGameData() {
            try {
                const savedHigh = localStorage.getItem('stellar_drift_high');
                const savedCredits = localStorage.getItem('stellar_drift_credits');
                const savedAbility = localStorage.getItem('stellar_drift_ability');

                if (savedHigh !== null) highScore = parseInt(savedHigh, 10);
                if (savedCredits !== null) totalCredits = parseInt(savedCredits, 10);
                if (savedAbility) {
                    player.equippedAbility = savedAbility;
                    if (savedAbility === 'shield') player.hasShield = true;
                }
                highScoreDisplay.textContent = `HIGH: ${highScore}`;
            } catch (e) {}
        }

        function saveGameData() {
            try {
                localStorage.setItem('stellar_drift_high', highScore);
                localStorage.setItem('stellar_drift_credits', totalCredits);
                if (player.equippedAbility) {
                    localStorage.setItem('stellar_drift_ability', player.equippedAbility);
                }
            } catch (e) {}
        }

        let currentDifficulty = 'normal'; 
        difficultyToggleBtn.addEventListener("click", () => {
            if (currentDifficulty === 'normal') {
                currentDifficulty = 'hard';
                difficultyToggleBtn.textContent = "MODE: HARD";
                difficultyToggleBtn.style.borderColor = "#e2738a";
            } else if (currentDifficulty === 'hard') {
                currentDifficulty = 'easy';
                difficultyToggleBtn.textContent = "MODE: EASY";
                difficultyToggleBtn.style.borderColor = "#a8dadc";
            } else {
                currentDifficulty = 'normal';
                difficultyToggleBtn.textContent = "MODE: NORMAL";
                difficultyToggleBtn.style.borderColor = "#6c5b7b";
            }
        });

        let audioCtx = null;
        function playSound(type) {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'score') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, now);
                    osc.frequency.exponentialRampToValueAtTime(880, now + 0.15);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'crystal') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.exponentialRampToValueAtTime(1046.5, now + 0.3);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'fuel') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(330, now);
                    osc.frequency.exponentialRampToValueAtTime(660, now + 0.25);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'bounce') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.exponentialRampToValueAtTime(440, now + 0.2);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else if (type === 'blink' || type === 'special') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(300, now);
                    osc.frequency.exponentialRampToValueAtTime(900, now + 0.2);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else if (type === 'pulse') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, now);
                    osc.frequency.exponentialRampToValueAtTime(40, now + 0.35);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else if (type === 'hit') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(120, now);
                    osc.frequency.linearRampToValueAtTime(40, now + 0.3);
                    gain.gain.setValueAtTime(0.25, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'cheat') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.1);
                    osc.frequency.setValueAtTime(783.99, now + 0.2);
                    osc.frequency.setValueAtTime(1046.50, now + 0.3);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                }
            } catch (e) {}
        }

        let tutorialStep = 0;
        const tutorialSteps = [
            {
                title: "STEP 1: ZERO-G THRUSTERS",
                text: "Use keys <strong>W A S D</strong> to push your thrusters. Moving consumes fuel!"
            },
            {
                title: "STEP 2: FUEL & REFUELING",
                text: "Watch your green fuel bar! Collect blue fuel canisters to keep your thrusters powered."
            },
            {
                title: "STEP 3: SECTOR CRYSTALS",
                text: "Hover near pulsing sector crystals for 10 seconds to harvest stardust, and watch out for incoming space debris!"
            },
            {
                title: "STEP 4: ABILITIES & PAUSING",
                text: "Press <strong>SPACEBAR</strong> to activate your equipped blessing, and press <strong>ESC</strong> to pause."
            }
        ];

        const ambientStars = [];
        for(let i=0; i<60; i++) {
            ambientStars.push({
                x: Math.random() * window.innerWidth,
                y: Math.random() * window.innerHeight,
                size: Math.random() * 2 + 1,
                alpha: Math.random()
            });
        }

        let particles = [];
        let crystals = [];
        let fuelCanisters = [];
        let crystalSpawnTimer = 0;
        let fuelSpawnTimer = 0;

        const player = {
            x: window.innerWidth / 2,
            y: window.innerHeight / 2,
            vx: 0,
            vy: 0,
            accel: 0.38,
            friction: 0.93,
            maxSpeed: 5.8,
            size: 10,
            equippedAbility: null, 
            cooldownTime: 0,
            maxCooldown: 0,
            hasShield: false
        };

        let obstacles = [];
        let spawnTimer = 0;
        let spawnInterval = 55; 
        let speedMultiplier = 1.0;

        const keys = {};

        window.addEventListener("keydown", (e) => {
            keys[e.code] = true;
            if (e.code === "Escape") {
                if (gameRunning) {
                    togglePause();
                }
            }
            if (e.code === "Space" && gameRunning && !gamePaused) {
                useAbility();
            }

            if (!shopScreen.classList.contains("hidden")) {
                if (e.code === konamiSequence[konamiInputIndex]) {
                    konamiInputIndex++;
                    if (konamiInputIndex === konamiSequence.length) {
                        const choice = prompt("✨ KONAMI CODE ACCEPTED! Choose your cheat ability:\n1. Invincibility (Type '1')\n2. Crystal Vacuum (Type '2')\n3. Time Freeze (Type '3')");
                        if (choice === '1') {
                            cheatedAbilityMode = 'godmode';
                            cheatStatus.textContent = "✨ CHEATS: INVINCIBILITY ENABLED ✨";
                        } else if (choice === '2') {
                            cheatedAbilityMode = 'vacuum';
                            cheatStatus.textContent = "✨ CHEATS: CRYSTAL VACUUM ENABLED ✨";
                        } else if (choice === '3') {
                            cheatedAbilityMode = 'freeze';
                            cheatStatus.textContent = "✨ CHEATS: TIME FREEZE ENABLED ✨";
                        } else {
                            cheatedAbilityMode = 'godmode';
                            cheatStatus.textContent = "✨ CHEATS: INVINCIBILITY ENABLED (Default) ✨";
                        }
                        isCheatedRun = true;
                        playSound('cheat');
                        konamiInputIndex = 0;
                    }
                } else {
                    konamiInputIndex = (e.code === konamiSequence[0]) ? 1 : 0;
                }
            }
        });

        window.addEventListener("keyup", (e) => {
            keys[e.code] = false;
        });

        document.getElementById("to-game-btn").addEventListener("click", startGame);
        document.getElementById("to-shop-btn").addEventListener("click", () => {
            konamiInputIndex = 0;
            if (!cheatStatus.textContent) {
                cheatStatus.textContent = isCheatedRun ? `✨ CHEATS: ${cheatedAbilityMode.toUpperCase()} ACTIVE ✨` : "";
            }
            showScreen(shopScreen);
        });
        document.getElementById("to-tutorial-btn").addEventListener("click", startTutorial);
        document.getElementById("tutorial-next-btn").addEventListener("click", nextTutorialStep);
        document.getElementById("tutorial-back-btn").addEventListener("click", () => showScreen(menuScreen));
        document.getElementById("back-to-menu-shop").addEventListener("click", () => showScreen(menuScreen));
        document.getElementById("resume-btn").addEventListener("click", togglePause);
        document.getElementById("menu-from-pause-btn").addEventListener("click", () => {
            gamePaused = false;
            showScreen(menuScreen);
        });
        document.getElementById("restart-btn").addEventListener("click", startGame);
        document.getElementById("menu-from-gameover-btn").addEventListener("click", () => showScreen(menuScreen));

        function showScreen(screenEl) {
            menuScreen.classList.add("hidden");
            shopScreen.classList.add("hidden");
            tutorialScreen.classList.add("hidden");
            pauseScreen.classList.add("hidden");
            gameoverScreen.classList.add("hidden");
            screenEl.classList.remove("hidden");
        }

        function togglePause() {
            if (!gameRunning) return;
            gamePaused = !gamePaused;
            if (gamePaused) {
                showScreen(pauseScreen);
            } else {
                pauseScreen.classList.add("hidden");
                loop();
            }
        }

        function startTutorial() {
            tutorialStep = 0;
            updateTutorialContent();
            showScreen(tutorialScreen);
        }

        function updateTutorialContent() {
            const step = tutorialSteps[tutorialStep];
            tutorialTitle.textContent = step.title;
            tutorialText.innerHTML = step.text;
            if (tutorialStep === tutorialSteps.length - 1) {
                tutorialNextBtn.textContent = "START DRIFT";
            } else {
                tutorialNextBtn.textContent = "NEXT";
            }
        }

        function nextTutorialStep() {
            tutorialStep++;
            if (tutorialStep >= tutorialSteps.length) {
                startGame();
            } else {
                updateTutorialContent();
            }
        }

        function buyAbility(type, cost) {
            if (totalCredits >= cost) {
                totalCredits -= cost;
                player.equippedAbility = type;
                if (type === 'shield') player.hasShield = true;
                saveGameData();
                alert(`Unlocked blessing: ${type.toUpperCase()}`);
            } else {
                alert("Not enough stardust yet! Gather more credits in the sector.");
            }
        }

        function useAbility() {
            if (!player.equippedAbility || player.cooldownTime > 0) return;

            const ab = player.equippedAbility;
            if (ab === 'blink') {
                playSound('blink');
                const angle = Math.atan2(player.vy, player.vx) || 0;
                player.x += Math.cos(angle) * 70;
                player.y += Math.sin(angle) * 70;
                player.cooldownTime = 360;
            } 
            else if (ab === 'pulse') {
                playSound('pulse');
                obstacles = obstacles.filter(obs => Math.hypot(player.x - obs.x, player.y - obs.y) > 140);
                player.cooldownTime = 600;
            }
            else if (ab === 'shield' && !player.hasShield) {
                playSound('blink');
                player.hasShield = true;
                player.cooldownTime = 480;
            }
            else if (ab === 'magnet') {
                playSound('special');
                activeEffectTimer = 180;
                player.cooldownTime = 540;
            }
            else if (ab === 'cloak') {
                playSound('special');
                activeEffectTimer = 120;
                player.cooldownTime = 480;
            }
            else if (ab === 'decoy') {
                playSound('special');
                decoyEntity = { x: player.x, y: player.y, life: 300 };
                player.cooldownTime = 720;
            }
        }

        function startGame() {
            menuScreen.classList.add("hidden");
            shopScreen.classList.add("hidden");
            tutorialScreen.classList.add("hidden");
            pauseScreen.classList.add("hidden");
            gameoverScreen.classList.add("hidden");

            score = 0;
            fuel = 100;
            obstacles = [];
            particles = [];
            crystals = [];
            fuelCanisters = [];
            positionHistory = [];
            decoyEntity = null;
            spawnTimer = 0;
            crystalSpawnTimer = 0;
            fuelSpawnTimer = 0;
            activeEffectTimer = 0;
            
            if (currentDifficulty === 'easy') {
                spawnInterval = 75;
                speedMultiplier = 0.8;
            } else if (currentDifficulty === 'hard') {
                spawnInterval = 35;
                speedMultiplier = 1.35;
            } else {
                spawnInterval = 55;
                speedMultiplier = 1.0;
            }

            player.x = window.innerWidth / 2;
            player.y = window.innerHeight / 2;
            player.vx = 0;
            player.vy = 0;
            player.cooldownTime = 0;
            if (player.equippedAbility === 'shield' || isCheatedRun) {
                player.hasShield = true;
            }

            gameRunning = true;
            gamePaused = false;
            scoreDisplay.textContent = `STARDUST: ${score}`;
            updateHudDisplay();

            loop();
        }

        function updateHudDisplay() {
            fuelBar.style.width = `${Math.max(0, fuel)}%`;
            fuelBar.style.backgroundColor = fuel < 25 ? '#e2738a' : '#06d6a0';

            if (isCheatedRun) {
                abilityHud.style.display = "block";
                abilityHud.textContent = `CHEAT ACTIVE: ${cheatedAbilityMode.toUpperCase()}`;
                return;
            }

            if (!player.equippedAbility) {
                abilityHud.style.display = "none";
                return;
            }

            abilityHud.style.display = "block";
            if (player.cooldownTime > 0) {
                abilityHud.textContent = `COOLDOWN: ${Math.ceil(player.cooldownTime / 60)}s`;
            } else if (activeEffectTimer > 0) {
                abilityHud.textContent = `ACTIVE: ${player.equippedAbility.toUpperCase()} (${Math.ceil(activeEffectTimer/60)}s)`;
            } else if (player.equippedAbility === 'rewind') {
                abilityHud.textContent = `CHRONO REWIND: READY [AUTO]`;
            } else {
                abilityHud.textContent = `READY [SPACE]: ${player.equippedAbility.toUpperCase()}`;
            }
        }

        function gameOver() {
            playSound('hit');
            gameRunning = false;
            cancelAnimationFrame(animationFrameId);
            
            totalCredits += score; 
            if (score > highScore) {
                highScore = score;
                highScoreDisplay.textContent = `HIGH: ${highScore}`;
            }

            saveGameData();

            if (isCheatedRun) {
                finalScoreText.textContent = `Cheated Stardust: You gathered ${score} Stardust with cheats enabled!`;
            } else {
                finalScoreText.textContent = `You gathered ${score} Stardust this drift! Total Pouch: ${totalCredits} SD`;
            }
            showScreen(gameoverScreen);
            player.hasShield = false;
        }

        function spawnObstacle() {
            const size = Math.random() * 22 + 16;
            const angle = Math.random() * Math.PI * 2;
            const spawnRadius = Math.max(window.innerWidth, window.innerHeight) / 2 + 50;
            const x = window.innerWidth / 2 + Math.cos(angle) * spawnRadius;
            const y = window.innerHeight / 2 + Math.sin(angle) * spawnRadius;
            
            const targetX = window.innerWidth / 2 + (Math.random() - 0.5) * 200;
            const targetY = window.innerHeight / 2 + (Math.random() - 0.5) * 200;
            const dx = targetX - x;
            const dy = targetY - y;
            const dist = Math.hypot(dx, dy);
            
            let baseSpeed = (Math.random() * 1.2 + 1.8 + (score / 400)) * speedMultiplier;

            obstacles.push({
                x: x,
                y: y,
                vx: (dx / dist) * baseSpeed,
                vy: (dy / dist) * baseSpeed,
                size: size
            });
        }

        function spawnCrystal() {
            const margin = 80;
            crystals.push({
                x: Math.random() * (window.innerWidth - margin * 2) + margin,
                y: Math.random() * (window.innerHeight - margin * 2) + margin,
                progress: 0,
                maxProgress: cheatedAbilityMode === 'vacuum' ? 60 : 600,
                size: 12
            });
        }

        function spawnFuel() {
            const margin = 80;
            fuelCanisters.push({
                x: Math.random() * (window.innerWidth - margin * 2) + margin,
                y: Math.random() * (window.innerHeight - margin * 2) + margin,
                size: 10
            });
        }

        function update() {
            if (gamePaused) return;

            if (player.cooldownTime > 0) player.cooldownTime--;
            if (activeEffectTimer > 0) activeEffectTimer--;

            positionHistory.push({ x: player.x, y: player.y });
            if (positionHistory.length > 60) positionHistory.shift();

            let activeMaxSpeed = player.maxSpeed;
            let currentAccel = player.accel;

            let accelerating = false;
            if (fuel > 0) {
                if (keys["KeyW"] || keys["ArrowUp"]) { player.vy -= currentAccel; accelerating = true; }
                if (keys["KeyS"] || keys["ArrowDown"]) { player.vy += currentAccel; accelerating = true; }
                if (keys["KeyA"] || keys["ArrowLeft"]) { player.vx -= currentAccel; accelerating = true; }
                if (keys["KeyD"] || keys["ArrowRight"]) { player.vx += currentAccel; accelerating = true; }
            }

            if (accelerating) {
                fuel -= 0.08;
                if (fuel <= 0) fuel = 0;
            } else {
                fuel += 0.02;
                if (fuel > maxFuel) fuel = maxFuel;
            }

            player.vx *= player.friction;
            player.vy *= player.friction;

            const currentVel = Math.hypot(player.vx, player.vy);
            if (currentVel > activeMaxSpeed) {
                player.vx = (player.vx / currentVel) * activeMaxSpeed;
                player.vy = (player.vy / currentVel) * activeMaxSpeed;
            }

            if (currentVel > 0.4) {
                const moveAngle = Math.atan2(player.vy, player.vx);
                const backX = player.x - Math.cos(moveAngle) * 10;
                const backY = player.y - Math.sin(moveAngle) * 10;

                particles.push({
                    x: backX + (Math.random() - 0.5) * 4,
                    y: backY + (Math.random() - 0.5) * 4,
                    vx: -player.vx * 0.3 + (Math.random() - 0.5) * 0.8,
                    vy: -player.vy * 0.3 + (Math.random() - 0.5) * 0.8,
                    color: isCheatedRun ? "#ffd166" : "#ff8800",
                    size: Math.random() * 3.5 + 1.5,
                    life: 1.0,
                    decay: 0.06
                });
            }

            player.x += player.vx;
            player.y += player.vy;

            if (decoyEntity) {
                decoyEntity.life--;
                if (decoyEntity.life <= 0) decoyEntity = null;
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;
                if (p.life <= 0) particles.splice(i, 1);
            }

            crystalSpawnTimer++;
            if (crystalSpawnTimer >= (cheatedAbilityMode === 'vacuum' ? 100 : 450) && crystals.length < 5) {
                spawnCrystal();
                crystalSpawnTimer = 0;
            }

            fuelSpawnTimer++;
            if (fuelSpawnTimer >= 500 && fuelCanisters.length < 4) {
                spawnFuel();
                fuelSpawnTimer = 0;
            }

            for (let i = crystals.length - 1; i >= 0; i--) {
                const c = crystals[i];
                if (cheatedAbilityMode === 'vacuum' || (player.equippedAbility === 'magnet' && activeEffectTimer > 0)) {
                    const angleToPlayer = Math.atan2(player.y - c.y, player.x - c.x);
                    c.x += Math.cos(angleToPlayer) * 3;
                    c.y += Math.sin(angleToPlayer) * 3;
                }

                const distToPlayer = Math.hypot(player.x - c.x, player.y - c.y);
                if (distToPlayer <= 35) {
                    c.progress += (cheatedAbilityMode === 'vacuum' || (player.equippedAbility === 'magnet' && activeEffectTimer > 0)) ? 25 : 1;
                    if (c.progress >= c.maxProgress) {
                        score += 50; 
                        playSound('crystal');
                        crystals.splice(i, 1);
                        scoreDisplay.textContent = `STARDUST: ${score}`;
                    }
                }
            }

            for (let i = fuelCanisters.length - 1; i >= 0; i--) {
                const f = fuelCanisters[i];
                if (Math.hypot(player.x - f.x, player.y - f.y) < 25) {
                    fuel = Math.min(maxFuel, fuel + 40);
                    playSound('fuel');
                    fuelCanisters.splice(i, 1);
                }
            }

            // Screen boundary bouncing
            const padding = 20;
            if (player.x < padding) {
                player.x = padding;
                player.vx *= -0.65;
                playSound('bounce');
            } else if (player.x > window.innerWidth - padding) {
                player.x = window.innerWidth - padding;
                player.vx *= -0.65;
                playSound('bounce');
            }
            if (player.y < padding) {
                player.y = padding;
                player.vy *= -0.65;
                playSound('bounce');
            } else if (player.y > window.innerHeight - padding) {
                player.y = window.innerHeight - padding;
                player.vy *= -0.65;
                playSound('bounce');
            }

            spawnTimer++;
            if (spawnTimer >= spawnInterval) {
                spawnObstacle();
                spawnTimer = 0;
                if (spawnInterval > 20) spawnInterval -= 0.4;
            }

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                let obsSpeedFactor = cheatedAbilityMode === 'freeze' ? 0.15 : 1.0;

                if (decoyEntity) {
                    const angleToDecoy = Math.atan2(decoyEntity.y - obs.y, decoyEntity.x - obs.x);
                    obs.vx += Math.cos(angleToDecoy) * 0.04;
                    obs.vy += Math.sin(angleToDecoy) * 0.04;
                }

                obs.x += obs.vx * obsSpeedFactor;
                obs.y += obs.vy * obsSpeedFactor;

                const hitDist = Math.hypot(player.x - obs.x, player.y - obs.y);

                if (hitDist < player.size + obs.size / 2) {
                    let isCloaked = (player.equippedAbility === 'cloak' && activeEffectTimer > 0);
                    if (cheatedAbilityMode === 'godmode' || player.hasShield || isCloaked) {
                        playSound('hit');
                        if (!cheatedAbilityMode && !isCloaked) player.hasShield = false;
                        obstacles.splice(i, 1); 
                        player.cooldownTime = 480; 
                        continue;
                    } else if (player.equippedAbility === 'rewind' && player.cooldownTime === 0) {
                        playSound('special');
                        if (positionHistory.length > 0) {
                            const pastPos = positionHistory[0];
                            player.x = pastPos.x;
                            player.y = pastPos.y;
                            player.vx = 0;
                            player.vy = 0;
                        }
                        obstacles.splice(i, 1);
                        player.cooldownTime = 1800; // 30 seconds cooldown
                        continue;
                    } else {
                        gameOver();
                        return;
                    }
                }

                // Remove out-of-bounds obstacles
                if (obs.x < -100 || obs.x > window.innerWidth + 100 || obs.y < -100 || obs.y > window.innerHeight + 100) {
                    obstacles.splice(i, 1);
                    score += 10; 
                    playSound('score');
                    scoreDisplay.textContent = `STARDUST: ${score}`;
                }
            }
            updateHudDisplay();
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = "#f7ede2";
            for(let star of ambientStars) {
                star.alpha += 0.01;
                let currentAlpha = (Math.sin(star.alpha) + 1) / 2 * 0.4 + 0.1;
                ctx.globalAlpha = currentAlpha;
                ctx.fillRect(star.x, star.y, star.size, star.size);
            }
            ctx.globalAlpha = 1.0;

            // Draw Fuel Canisters
            for (let f of fuelCanisters) {
                ctx.save();
                ctx.shadowBlur = 10;
                ctx.shadowColor = "#3a86ff";
                ctx.fillStyle = "#3a86ff";
                ctx.beginPath();
                ctx.arc(f.x, f.y, f.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Draw Sector Crystals
            for (let c of crystals) {
                ctx.save();
                ctx.shadowBlur = 10;
                ctx.shadowColor = "#06d6a0";
                ctx.fillStyle = "#06d6a0";
                ctx.beginPath();
                ctx.arc(c.x, c.y, c.size, 0, Math.PI * 2);
                ctx.fill();

                if (c.progress > 0) {
                    ctx.strokeStyle = "#ffd166";
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    const endAngle = (c.progress / c.maxProgress) * Math.PI * 2 - Math.PI / 2;
                    ctx.arc(c.x, c.y, c.size + 5, -Math.PI / 2, endAngle);
                    ctx.stroke();
                }
                ctx.restore();
            }

            if (decoyEntity) {
                ctx.save();
                ctx.strokeStyle = "#ffd166";
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.arc(decoyEntity.x, decoyEntity.y, 12, 0, Math.PI * 2);
                ctx.stroke();
                ctx.restore();
            }

            for (let p of particles) {
                ctx.save();
                ctx.globalAlpha = p.life;
                ctx.fillStyle = p.color;
                ctx.shadowBlur = 6;
                ctx.shadowColor = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            ctx.save();
            ctx.translate(player.x, player.y);
            let angle = Math.atan2(player.vy, player.vx) + Math.PI / 2;
            if (Math.hypot(player.vx, player.vy) < 0.1) angle = 0;
            ctx.rotate(angle);

            let isCloaked = (player.equippedAbility === 'cloak' && activeEffectTimer > 0);
            ctx.globalAlpha = isCloaked ? 0.4 : 1.0;

            ctx.shadowBlur = 12;
            ctx.shadowColor = isCheatedRun ? "#06d6a0" : "#ffd166";
            ctx.fillStyle = isCheatedRun ? "#06d6a0" : "#ffd166";
            
            ctx.beginPath();
            ctx.moveTo(0, -12);
            ctx.lineTo(-8, 10);
            ctx.lineTo(0, 5);
            ctx.lineTo(8, 10);
            ctx.closePath();
            ctx.fill();
            ctx.restore();

            if (player.hasShield || cheatedAbilityMode === 'godmode') {
                ctx.strokeStyle = cheatedAbilityMode === 'godmode' ? "#06d6a0" : "#e2738a";
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(player.x, player.y, 18, 0, Math.PI * 2);
                ctx.stroke();
            }

            ctx.shadowBlur = 8;
            ctx.shadowColor = "#6c5b7b";
            for (let obs of obstacles) {
                ctx.fillStyle = "#453a56";
                ctx.beginPath();
                ctx.arc(obs.x, obs.y, obs.size/2, 0, Math.PI * 2);
                ctx.fill();
            }
            
            ctx.shadowBlur = 0;
        }

        function loop() {
            if (!gameRunning || gamePaused) return;
            update();
            draw();
            animationFrameId = requestAnimationFrame(loop);
        }

        loadGameData();
    </script>
</body>
</html>
